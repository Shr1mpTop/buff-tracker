{
  "apps": [
    {
      "name": "cs2-tracker-api",
      "script": "uvicorn",
      "args": "api.main:app --host 0.0.0.0 --port 8010 --env-file .env",
      "cwd": "/root/buff-tracker",
      "interpreter": "python3",
      "instances": 1,
      "exec_mode": "fork",
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "500M",
      "env": {
        "NODE_ENV": "production"
      },
      "error_file": "/root/buff-tracker/logs/err.log",
      "out_file": "/root/buff-tracker/logs/out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z"
    }
  ]
}
